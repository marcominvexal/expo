+  "https://www.googleapis.com/auth/drive",
+] as const;
+
+export const DEFAULT_SPREADSHEET_ID =
+  process.env.FUNNEL_SPREADSHEET_ID || "1E9gYdeZUwMEmnwe164io7E47QuXnBfYcELdulUroN_4";
+
