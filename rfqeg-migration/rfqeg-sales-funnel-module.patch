+{
+  "year": 2026,
+  "country": "Pakistan",
+  "_comment": "Official Pakistan public holidays for TAT. Weekends (Sat/Sun) are excluded separately. Lunar holidays use these projected calendar dates.",
+  "dates": [
+    "2026-02-05",
